# Production Environment Configuration
# WARNING: Replace all placeholder values with real credentials

ENV=production
DEBUG=false
LOG_LEVEL=INFO

# SERP API (get key from serpapi.com)
USE_MOCK_SERP=false
SERPAPI_KEY=your_real_serpapi_key_here

# AI Configuration
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=your_real_gemini_api_key_here

# Database (use PostgreSQL for production)
DATABASE_URL=postgresql://user:password@localhost:5432/seo_analyzer

# CORS (set to your actual domain)
ALLOWED_ORIGINS=https://yourdomain.com

# Admin token (generate secure random token)
ADMIN_TOKEN=your_secure_random_token_here

# Rate limiting
RATE_LIMIT_ENABLED=true
