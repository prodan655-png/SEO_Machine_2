# Environment Variables Template
# Copy this file to .env.development or .env.production and fill in real values

# Environment mode
ENV=development  # development | production
DEBUG=true
LOG_LEVEL=DEBUG  # DEBUG | INFO | WARNING | ERROR

# SERP API
USE_MOCK_SERP=true  # Set to false for production
SERPAPI_KEY=your_serpapi_key_here

# AI Configuration
AI_ENABLED=false  # Set to true to enable AI features
AI_PROVIDER=gemini  # gemini | openai | anthropic | mock
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database
DATABASE_URL=sqlite:///./dev_seo_analyzer.db  # Or postgresql://user:pass@host:5432/db

# CORS
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Admin Token (simple authentication)
ADMIN_TOKEN=your_secure_random_token_here

# Rate Limiting
RATE_LIMIT_ENABLED=false  # Set to true for production
