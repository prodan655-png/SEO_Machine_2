# Копія .env.development без секретів
# Скопіюйте цей файл як .env.development і заповніть реальними значеннями

# AI Configuration
AI_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key_here

# SERP API Configuration
SERPAPI_PROVIDER=serper
SERPAPI_KEY=your_serper_api_key_here
USE_MOCK_SERP=false

# Database
DATABASE_URL=sqlite:///./seo_machine.db

# Server
DEBUG=true
